<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>أسئلة وليد</title>
</head>
<body>
  <h1>مرحبا! 👋</h1>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      padding: 40px 20px;
      background: #f5f5f5;
    }

    #quiz {
      max-width: 500px;
      margin: auto;
      background: white;
      padding: 25px;
      border-radius: 15px;
    }

    input {
      width: 90%;
      padding: 12px;
      font-size: 16px;
      margin: 15px 0;
    }

    button {
      padding: 12px 25px;
      font-size: 16px;
      cursor: pointer;
    }

    #result {
      max-width: 500px;
      margin: auto;
      background: white;
      padding: 25px;
      border-radius: 15px;
    }
  </style>
</head>
<body>
  <div id="quiz">
    <h1>مرحبا 👋</h1>
<h2 id="question"></h2>

<input id="answer" type="text" placeholder="اكتب إجابتك هنا">

<br>

<button onclick="nextQuestion()">التالي ➜</button>  <script>
    const questions = [
      "ما اسمك؟",
      "كم عمرك؟",
      "ما هو لونك المفضل؟",
      "ما هي هوايتك المفضلة؟",
      "ما هو أكلك المفضل؟",
      "ما هو حلمك في المستقبل؟",
      "ما الشيء الذي يجعلك سعيداً؟",
      "لو تستطيع السفر لأي بلد، أين ستذهب؟",
      "ما المهارة التي تريد تعلمها؟",
      "اكتب شيئاً جميلاً عن نفسك."
    ];

    let current = 0;

    document.getElementById("question").textContent = questions[current];

    function nextQuestion() {
      const answer = document.getElementById("answer");

      if (answer.value.trim() === "") {
        alert("اكتب إجابتك أولاً 🙂");
        return;
      }

      current++;
      answer.value = "";

      if (current < questions.length) {
        document.getElementById("question").textContent = questions[current];
      } else {
        document.getElementById("quiz").style.display = "none";
        document.getElementById("result").style.display = "block";
      }
    }
  </script>
</body>
</html>
